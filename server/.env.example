# 🛡️ VaultText Advanced Platform - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000

# =============================================================================
# 📧➡️📱 EMAIL-TO-SMS BRIDGE CONFIGURATION
# =============================================================================
# IMAP Email Account for receiving emails
EMAIL_BRIDGE_IMAP_HOST=imap.gmail.com
EMAIL_BRIDGE_IMAP_PORT=993
EMAIL_BRIDGE_USER=your-email@gmail.com
EMAIL_BRIDGE_PASS=your-app-password

# Email Bridge Domain for generating forwarding addresses
EMAIL_BRIDGE_DOMAIN=your-domain.com
EMAIL_BRIDGE_API_KEY=your-webhook-api-key

# SendGrid Integration (optional - for webhook emails)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_WEBHOOK_SECRET=your-webhook-secret

# Mailgun Integration (optional - for webhook emails)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# 📱🔐 VIRTUAL NUMBERS & SMS PROVIDERS
# =============================================================================
# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
TWILIO_WEBHOOK_URL=https://your-domain.com/api/sms/webhook/twilio

# MessageBird Configuration
MESSAGEBIRD_API_KEY=your-messagebird-api-key
MESSAGEBIRD_ORIGINATOR=your-messagebird-originator

# Vonage (Nexmo) Configuration
VONAGE_API_KEY=your-vonage-api-key
VONAGE_API_SECRET=your-vonage-api-secret
VONAGE_WEBHOOK_URL=https://your-domain.com/api/sms/webhook/vonage

# Plivo Configuration
PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token

# =============================================================================
# 🔒 AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Keys
ENCRYPTION_KEY=your-256-bit-encryption-key
ENCRYPTION_IV=your-initialization-vector

# =============================================================================
# 🗄️ DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/vaulttext
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vaulttext
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# MongoDB (optional)
MONGODB_URI=mongodb://localhost:27017/vaulttext

# =============================================================================
# 📊 FREE-FOR-DEV SERVICE INTEGRATIONS
# =============================================================================
# Sentry Error Tracking (5,000 errors/month free)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0

# EmailOctopus Newsletter Service (2,500 subscribers free)
EMAILOCTOPUS_API_KEY=your-emailoctopus-api-key
EMAILOCTOPUS_LIST_ID=your-list-id

# Backblaze B2 Storage (10GB free)
BACKBLAZE_B2_KEY_ID=your-b2-key-id
BACKBLAZE_B2_APPLICATION_KEY=your-b2-application-key
BACKBLAZE_B2_BUCKET_NAME=your-bucket-name
BACKBLAZE_B2_BUCKET_ID=your-bucket-id

# New Relic APM (100GB/month free)
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
NEW_RELIC_APP_NAME=VaultText Platform

# Auth0 Authentication (7,000 MAU free)
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Hugging Face AI/NLP (Free tier)
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Pusher Real-time (100 connections free)
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=us2

# Grafana Cloud (10K metrics free)
GRAFANA_CLOUD_API_KEY=your-grafana-api-key
GRAFANA_CLOUD_USER=your-grafana-user

# =============================================================================
# ☁️ CLOUD STORAGE & CDN
# =============================================================================
# AWS S3 (optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket

# Cloudflare CDN
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id

# =============================================================================
# 🤖 AI & MACHINE LEARNING
# =============================================================================
# OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Comet ML Experiment Tracking (Free tier)
COMET_API_KEY=your-comet-api-key
COMET_PROJECT_NAME=vaulttext

# Neptune.ai ML Monitoring (Free tier)
NEPTUNE_API_TOKEN=your-neptune-api-token
NEPTUNE_PROJECT=your-neptune-project

# =============================================================================
# ⛓️ BLOCKCHAIN & WEB3
# =============================================================================
# Ethereum Configuration
ETH_PRIVATE_KEY=your-ethereum-private-key
ETH_RPC_URL=https://mainnet.infura.io/v3/your-infura-key
ETH_CONTRACT_ADDRESS=your-contract-address

# Polygon Configuration
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your-infura-key
POLYGON_PRIVATE_KEY=your-polygon-private-key

# Tatum Blockchain API (Free tier)
TATUM_API_KEY=your-tatum-api-key

# Moralis Web3 API (Free tier)
MORALIS_API_KEY=your-moralis-api-key

# IPFS Configuration
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_API_KEY=your-ipfs-api-key
IPFS_API_SECRET=your-ipfs-api-secret

# =============================================================================
# 📈 MONITORING & ANALYTICS
# =============================================================================
# Redis for Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password

# Datadog Monitoring (Free tier)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# =============================================================================
# 📧 EMAIL SERVICES
# =============================================================================
# Resend Email Service (3,000 emails/month free)
RESEND_API_KEY=your-resend-api-key

# SMTP Configuration (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# =============================================================================
# 🔍 SEARCH & INDEXING
# =============================================================================
# Algolia Search (10K operations/month free)
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_API_KEY=your-algolia-api-key
ALGOLIA_SEARCH_KEY=your-algolia-search-key

# =============================================================================
# 💳 PAYMENT PROCESSING
# =============================================================================
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# =============================================================================
# 🛡️ SECURITY & COMPLIANCE
# =============================================================================
# Snyk Security Scanning (Free tier)
SNYK_TOKEN=your-snyk-token

# Rollbar Error Monitoring (Free tier)
ROLLBAR_ACCESS_TOKEN=your-rollbar-access-token

# =============================================================================
# 🔊 REAL-TIME COMMUNICATION
# =============================================================================
# Ably Real-time (3M messages/month free)
ABLY_API_KEY=your-ably-api-key

# WebSocket Configuration
WEBSOCKET_PORT=3001
WEBSOCKET_CORS_ORIGIN=http://localhost:3000

# =============================================================================
# 📱 BIOMETRIC AUTHENTICATION
# =============================================================================
# Face API Configuration
FACE_API_SUBSCRIPTION_KEY=your-face-api-key
FACE_API_ENDPOINT=https://your-region.api.cognitive.microsoft.com/

# =============================================================================
# 🌐 INTERNATIONALIZATION
# =============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh

# =============================================================================
# 🔧 DEVELOPMENT & TESTING
# =============================================================================
# Testing Database
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/vaulttext_test

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Debug Mode
DEBUG=vaulttext:*

# =============================================================================
# 🚀 DEPLOYMENT & SCALING
# =============================================================================
# PM2 Configuration
PM2_INSTANCES=max
PM2_EXEC_MODE=cluster

# Docker Configuration
DOCKER_IMAGE=vaulttext/platform
DOCKER_TAG=latest

# Health Check URLs
HEALTH_CHECK_URL=http://localhost:5000/health
METRICS_URL=http://localhost:5000/metrics

# =============================================================================
# 📊 ANALYTICS & TRACKING
# =============================================================================
# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX

# Mixpanel Analytics (Free tier)
MIXPANEL_TOKEN=your-mixpanel-token

# =============================================================================
# 🎯 FEATURE FLAGS
# =============================================================================
ENABLE_AI_ANALYSIS=true
ENABLE_BLOCKCHAIN_VERIFICATION=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_REAL_TIME_COLLABORATION=true
ENABLE_ADVANCED_ENCRYPTION=true
ENABLE_EMAIL_TO_SMS=true
ENABLE_TEMP_SOCIAL_NUMBERS=true
ENABLE_FREE_TIER_SERVICES=true

# =============================================================================
# 📝 RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_AUTH_MAX=5

# =============================================================================
# 🔄 CRON JOBS & BACKGROUND TASKS
# =============================================================================
ENABLE_CRON_JOBS=true
CLEANUP_INTERVAL=0 0 * * *
BACKUP_INTERVAL=0 2 * * *
STATS_INTERVAL=0 */6 * * *