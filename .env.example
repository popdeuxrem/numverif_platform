# 🛡️ VaultText Advanced Platform - Environment Configuration
# Copy this file to .env and update with your actual credentials

# ================================
# 🏢 Application Configuration
# ================================
NODE_ENV=development
PORT=5000
APP_NAME=VaultText Advanced Platform
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ================================
# 🔐 Security Configuration
# ================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
ENCRYPTION_KEY=your-32-character-encryption-key
BCRYPT_SALT_ROUNDS=12

# ================================
# 📱 Virtual Numbers & SMS Services
# ================================

# Primary SMS Providers
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

MESSAGEBIRD_API_KEY=your_messagebird_api_key
MESSAGEBIRD_ORIGINATOR=your_messagebird_originator

VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_PHONE_NUMBER=your_vonage_phone_number

PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_PHONE_NUMBER=your_plivo_phone_number

# WhatsApp Business API
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# ================================
# 📧 Email Services (Free-for.dev)
# ================================

# EmailOctopus - Newsletter service (2,500 subscribers, 10,000 emails/month)
EMAILOCTOPUS_API_KEY=your_emailoctopus_api_key
EMAILOCTOPUS_LIST_ID=your_emailoctopus_list_id

# Resend - Transactional emails (3,000 emails/month)
RESEND_API_KEY=your_resend_api_key

# EmailJS - Client-side email sending (200 requests/month)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# AhaSend - Email service (1,000 emails/month)
AHASEND_API_KEY=your_ahasend_api_key

# Brevo (formerly Sendinblue) - 9,000 emails/month
BREVO_API_KEY=your_brevo_api_key

# ================================
# 🔒 Enhanced Security (Free-for.dev)
# ================================

# Snyk - Vulnerability scanning (200 tests/month)
SNYK_TOKEN=your_snyk_token
SNYK_ORG_ID=your_snyk_org_id

# GitGuardian - Secret scanning
GITGUARDIAN_API_KEY=your_gitguardian_api_key

# SonarCloud - Code quality and security
SONAR_TOKEN=your_sonar_token
SONAR_PROJECT_KEY=your_sonar_project_key

# ================================
# 🔑 Authentication Services (Free-for.dev)
# ================================

# Auth0 - SSO service (7,000 active users)
AUTH0_DOMAIN=your_auth0_domain
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=your_auth0_audience

# Clerk - User management (500 MAUs)
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# SuperTokens - Open-source auth (5,000 MAUs)
SUPERTOKENS_CONNECTION_URI=your_supertokens_connection_uri
SUPERTOKENS_API_KEY=your_supertokens_api_key

# ================================
# 📊 Monitoring & Analytics (Free-for.dev)
# ================================

# Sentry - Error monitoring (5k errors/month)
SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project

# New Relic - Performance monitoring (100GB/month)
NEWRELIC_LICENSE_KEY=your_newrelic_license_key
NEWRELIC_APP_NAME=VaultText-Advanced-Platform

# Grafana Cloud - Metrics and logs (10,000 series, 50GB logs)
GRAFANA_API_KEY=your_grafana_api_key
GRAFANA_CLOUD_URL=your_grafana_cloud_url
GRAFANA_INSTANCE_ID=your_grafana_instance_id

# Datadog - Monitoring platform (5 hosts)
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# Rollbar - Exception monitoring (5,000 errors/month)
ROLLBAR_ACCESS_TOKEN=your_rollbar_access_token

# ================================
# 🗄️ Cloud Storage (Free-for.dev)
# ================================

# Backblaze B2 - Object storage (10GB free)
BACKBLAZE_KEY_ID=your_backblaze_key_id
BACKBLAZE_APPLICATION_KEY=your_backblaze_application_key
BACKBLAZE_BUCKET_NAME=your_backblaze_bucket_name

# Spheron - Decentralized storage (5GB, 100GB bandwidth)
SPHERON_TOKEN=your_spheron_token

# 4EVERLAND - IPFS/Arweave storage (6GB IPFS, 300MB Arweave)
EVERLAND_ACCESS_KEY=your_everland_access_key
EVERLAND_SECRET_KEY=your_everland_secret_key

# ================================
# ⛓️ Blockchain Services (Free-for.dev)
# ================================

# Tatum - Blockchain API (unlimited calls at 5 req/sec)
TATUM_API_KEY=your_tatum_api_key
TATUM_TESTNET=true

# Moralis - Web3 development platform
MORALIS_API_KEY=your_moralis_api_key
MORALIS_SERVER_URL=your_moralis_server_url
MORALIS_APP_ID=your_moralis_app_id

# Existing Blockchain Configuration
ETHEREUM_RPC_URL=your_ethereum_rpc_url
ETHEREUM_PRIVATE_KEY=your_ethereum_private_key
ETHEREUM_CONTRACT_ADDRESS=your_ethereum_contract_address

POLYGON_RPC_URL=your_polygon_rpc_url
POLYGON_PRIVATE_KEY=your_polygon_private_key

BSC_RPC_URL=your_bsc_rpc_url
BSC_PRIVATE_KEY=your_bsc_private_key

# IPFS Configuration
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_PROJECT_ID=your_ipfs_project_id
IPFS_PROJECT_SECRET=your_ipfs_project_secret

# ================================
# 🤖 AI Services (Free-for.dev)
# ================================

# Hugging Face - NLP models (30k input characters/month)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Comet ML - MLOps platform
COMET_API_KEY=your_comet_api_key
COMET_PROJECT_NAME=vaulttext-ai-models

# Neptune.ai - ML experiment tracking (100GB metadata)
NEPTUNE_API_TOKEN=your_neptune_api_token
NEPTUNE_PROJECT=your_neptune_project

# Existing AI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# ================================
# 🌐 API Management (Free-for.dev)
# ================================

# Zuplo - API management (100k requests/month)
ZUPLO_API_KEY=your_zuplo_api_key

# Kong - API platform
KONG_ADMIN_URL=http://localhost:8001
KONG_ADMIN_TOKEN=your_kong_admin_token

# ================================
# 📡 Real-time Communication (Free-for.dev)
# ================================

# Pusher - Real-time messaging (100 connections, 200k messages/day)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster

# Ably - Realtime platform (3M messages/month)
ABLY_API_KEY=your_ably_api_key

# ================================
# 🗃️ Database Configuration
# ================================

# PostgreSQL (Primary Database)
DATABASE_URL=postgresql://username:password@localhost:5432/vaulttext_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vaulttext_db
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# Redis (Cache & Sessions)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB (Optional - Document Storage)
MONGODB_URI=mongodb://localhost:27017/vaulttext_docs

# Elasticsearch (Search Engine)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ================================
# ☁️ Cloud Hosting (Free-for.dev)
# ================================

# Vercel - Frontend hosting (unlimited projects)
VERCEL_TOKEN=your_vercel_token

# Netlify - Static hosting (100GB bandwidth)
NETLIFY_AUTH_TOKEN=your_netlify_auth_token
NETLIFY_SITE_ID=your_netlify_site_id

# Railway - Backend hosting
RAILWAY_TOKEN=your_railway_token

# ================================
# 🔧 Development Tools (Free-for.dev)
# ================================

# CodeClimate - Code quality analysis
CODECLIMATE_REPO_TOKEN=your_codeclimate_repo_token

# Codecov - Code coverage
CODECOV_TOKEN=your_codecov_token

# ================================
# 🌍 External API Services
# ================================

# Geolocation Services
IPAPI_KEY=your_ipapi_key
IPGEOLOCATION_API_KEY=your_ipgeolocation_api_key

# Weather Services
OPENWEATHER_API_KEY=your_openweather_api_key

# Language Detection
DETECTLANGUAGE_API_KEY=your_detectlanguage_api_key

# ================================
# 📱 Mobile & Push Notifications
# ================================

# Firebase (for mobile apps)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# OneSignal - Push notifications (1M messages/month)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# ================================
# 🎨 CDN & Assets
# ================================

# Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# ================================
# 📈 Analytics Services
# ================================

# Google Analytics
GOOGLE_ANALYTICS_ID=your_google_analytics_id

# Mixpanel
MIXPANEL_TOKEN=your_mixpanel_token

# ================================
# 🔐 Biometric Services
# ================================

# Face recognition services
FACE_API_KEY=your_face_api_key
FACE_API_ENDPOINT=your_face_api_endpoint

# Voice recognition services
VOICE_API_KEY=your_voice_api_key

# ================================
# 🌐 Internationalization
# ================================

# Translation services
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
DEEPL_API_KEY=your_deepl_api_key

# ================================
# 🧪 Testing & QA
# ================================

# BrowserStack (for cross-browser testing)
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key

# ================================
# 📦 Package & Build
# ================================

# Docker configuration
DOCKER_REGISTRY=your_docker_registry
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_password

# ================================
# 🔍 Search Services
# ================================

# Algolia - Search as a service
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_api_key
ALGOLIA_SEARCH_KEY=your_algolia_search_key

# ================================
# 💳 Payment Services (if needed)
# ================================

# Stripe
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# ================================
# 📊 Business Intelligence
# ================================

# Observable - Data visualization (unlimited notebooks)
OBSERVABLE_API_KEY=your_observable_api_key

# ================================
# 🚨 Incident Management
# ================================

# PagerDuty
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key

# ================================
# 📋 Task Management
# ================================

# Webhooks for integrations
SLACK_WEBHOOK_URL=your_slack_webhook_url
DISCORD_WEBHOOK_URL=your_discord_webhook_url
TEAMS_WEBHOOK_URL=your_teams_webhook_url

# ================================
# 🎯 Feature Flags
# ================================

# LaunchDarkly
LAUNCHDARKLY_SDK_KEY=your_launchdarkly_sdk_key

# ================================
# 📝 Documentation
# ================================

# GitBook
GITBOOK_TOKEN=your_gitbook_token

# ================================
# 🔐 Secrets Management
# ================================

# HashiCorp Vault (if using)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your_vault_token

# ================================
# 🌟 Additional Free Services
# ================================

# JSON Placeholder - for testing
JSON_PLACEHOLDER_URL=https://jsonplaceholder.typicode.com

# RandomUser API - for test data
RANDOMUSER_API_URL=https://randomuser.me/api

# ================================
# 🚀 Performance Optimization
# ================================

# Enable/disable features for performance
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true
ENABLE_COMPRESSION=true
ENABLE_CORS=true

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache TTL (Time To Live) in seconds
CACHE_TTL=3600

# ================================
# 🐛 Debug Configuration
# ================================

# Debug flags
DEBUG=vaulttext:*
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_STACK_TRACES=false

# ================================
# 🌐 CORS Configuration
# ================================

CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ================================
# 📧 SMTP Configuration (Fallback)
# ================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ================================
# 🔒 SSL/TLS Configuration
# ================================

SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem
FORCE_HTTPS=false

# ================================
# 📱 Mobile App Configuration
# ================================

# Deep linking
APP_SCHEME=vaulttext
UNIVERSAL_LINK_DOMAIN=vaulttext.app

# ================================
# 🌍 Multi-tenant Configuration
# ================================

ENABLE_MULTI_TENANCY=false
DEFAULT_TENANT=default

# ================================
# 📈 Analytics & Tracking
# ================================

ENABLE_ANALYTICS=true
ENABLE_USER_TRACKING=true
ENABLE_PERFORMANCE_TRACKING=true

# ================================
# 🎨 UI/UX Configuration
# ================================

DEFAULT_THEME=light
ENABLE_DARK_MODE=true
DEFAULT_LANGUAGE=en
ENABLE_RTL=false

# ================================
# 📱 Progressive Web App
# ================================

ENABLE_PWA=true
PWA_SHORT_NAME=VaultText
PWA_THEME_COLOR=#2563eb

# ================================
# 🔄 Backup & Recovery
# ================================

BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
ENABLE_AUTO_BACKUP=true

# ================================
# 🎯 Environment Specific
# ================================

# Development
DEV_AUTO_RELOAD=true
DEV_ENABLE_PLAYGROUND=true

# Production
PROD_ENABLE_COMPRESSION=true
PROD_ENABLE_MINIFICATION=true
PROD_ENABLE_CACHING=true

# ================================
# 📊 Health Checks
# ================================

HEALTH_CHECK_INTERVAL=30000
ENABLE_READINESS_PROBE=true
ENABLE_LIVENESS_PROBE=true

# ================================
# 🔐 Security Headers
# ================================

ENABLE_HELMET=true
ENABLE_CSP=true
CSP_REPORT_URI=https://your-domain.report-uri.com/r/d/csp/enforce

# ================================
# 📝 Notes for Developers
# ================================

# To get started:
# 1. Copy this file to .env
# 2. Fill in the required credentials
# 3. Start with the core services first
# 4. Gradually add free-for.dev services
# 5. Test each service integration
# 6. Monitor usage to stay within free limits

# Free Service Priorities:
# High Priority: Sentry, New Relic, EmailOctopus, Backblaze B2
# Medium Priority: Auth0, Hugging Face, Pusher, Grafana
# Low Priority: Additional monitoring and analytics services

# Remember to:
# - Keep this file secure and never commit with real credentials
# - Use different credentials for development, staging, and production
# - Regularly rotate API keys and tokens
# - Monitor free tier usage limits
# - Document any custom configuration in your team wiki