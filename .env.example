# VaultText Advanced Platform Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/vaulttext
MONGODB_URI=mongodb://localhost:27017/vaulttext
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=your-super-secure-jwt-secret-here
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-here
ENCRYPTION_KEY=your-256-bit-encryption-key-here
BCRYPT_ROUNDS=12

# Virtual Numbers & OTP Configuration
# Twilio (Primary SMS Provider)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# MessageBird (Backup SMS Provider)
MESSAGEBIRD_API_KEY=your-messagebird-api-key

# Vonage (Backup SMS Provider)
VONAGE_API_KEY=your-vonage-api-key
VONAGE_API_SECRET=your-vonage-api-secret

# Plivo (Additional SMS Provider)
PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token
PLIVO_PHONE_NUMBER=+1234567890

# AI Services
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORGANIZATION=your-openai-org-id
AI_MODEL=gpt-4-turbo-preview

# Blockchain Configuration
ETHEREUM_PRIVATE_KEY=your-ethereum-private-key
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-project-id
ETHEREUM_CONTRACT_ADDRESS=0x123...
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your-project-id
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# IPFS Configuration
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_PROJECT_ID=your-ipfs-project-id
IPFS_PROJECT_SECRET=your-ipfs-project-secret

# Cloud Storage (AWS S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=vaulttext-documents
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.com

# Google Cloud (Alternative)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_KEY_FILE=path/to/service-account-key.json
GOOGLE_CLOUD_STORAGE_BUCKET=vaulttext-documents

# Email Services
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@vaulttext.com

# Payment Processing
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Social Authentication
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Elasticsearch
ELASTICSEARCH_HOST=localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn
MIXPANEL_TOKEN=your-mixpanel-token
GOOGLE_ANALYTICS_ID=GA-XXXXXXXX-X

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESS=true

# File Upload Limits
MAX_FILE_SIZE=100MB
MAX_FILES_PER_UPLOAD=10
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png,gif,mp4,avi,mov

# Biometric Authentication
FACE_API_KEY=your-face-api-key
FINGERPRINT_API_KEY=your-fingerprint-api-key
VOICE_API_KEY=your-voice-api-key

# Compliance & Audit
AUDIT_LOG_RETENTION_DAYS=2555
COMPLIANCE_MODE=strict
DATA_RESIDENCY=US
GDPR_ENABLED=true
HIPAA_ENABLED=false

# Advanced Features
ENABLE_BLOCKCHAIN=true
ENABLE_AI_ANALYSIS=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_VIRTUAL_NUMBERS=true
ENABLE_ADVANCED_ENCRYPTION=true
ENABLE_COLLABORATION=true
ENABLE_ANALYTICS=true

# Development & Testing
DEBUG=vaulttext:*
LOG_LEVEL=info
TESTING_MODE=false
MOCK_EXTERNAL_APIS=false

# Background Jobs
QUEUE_REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
JOB_TIMEOUT=300000

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=10000
WS_ENABLE_COMPRESSION=true

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/api/docs
SWAGGER_UI_ENABLED=true

# Health Checks
HEALTH_CHECK_TIMEOUT=5000
ENABLE_HEALTH_ENDPOINT=true
ENABLE_METRICS_ENDPOINT=true

# CDN Configuration
CDN_URL=https://cdn.vaulttext.com
STATIC_ASSETS_URL=https://static.vaulttext.com

# Internationalization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh,ar,hi,ru

# Performance
CACHE_TTL=3600
ENABLE_COMPRESSION=true
ENABLE_ETAG=true

# Security Headers
ENABLE_HSTS=true
ENABLE_CSRF_PROTECTION=true
ENABLE_XSS_PROTECTION=true
ENABLE_FRAME_OPTIONS=true